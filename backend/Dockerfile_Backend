# backend/Dockerfile
FROM mcr.microsoft.com/devcontainers/python:3.11-bullseye

# 環境変数の設定 (Pythonのバッファリングを無効化し、ログをリアルタイムで表示)
ENV PYTHONUNBUFFERED 1

# [任意] OSのパッケージを追加する場合
RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    && apt-get -y install --no-install-recommends build-essential libpq-dev

# 作業ディレクトリの設定
WORKDIR /workspaces/backend

# 依存ライブラリのコピーとインストール（あらかじめファイルがある場合）
# DevContainer起動時に自動で行う場合は、devcontainer.jsonのpostCreateCommandでも可
COPY requirements.txt* ./
RUN if [ -f "requirements.txt" ]; then pip install --no-cache-dir -r requirements.txt; fi

# ポートの公開（Flask/FastAPIなどのデフォルト 5000や8000）
EXPOSE 5000